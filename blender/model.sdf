<?xml version="1.0" ?>
<sdf version="1.7">
  <model name="test">
    <link name="testlink">
      <visual name="Cube">
        <geometry>
          <mesh>
            <uri>model://gold_base/meshes/model.dae</uri>
            <submesh>
              <name>Cube</name>
            </submesh>
          </mesh>
        </geometry>
        <material>
          <script>
            <uri>model://gold_base/materials/scripts/</uri>
            <uri>model://gold_base/materials/textures/</uri>
            <name>Gold/Material</name>
            <name>Gold/Metal</name>
  	  </script>
	</material>
      </visual>
      <light name="Light" type="point">
        <diffuse>1.0 1.0 1.0 1.0</diffuse>
        <attenuation>
          <range>40.0</range>
          <linear>0.0</linear>
          <quadratic>1.0</quadratic>
          <constant>1.0</constant>
        </attenuation>
        <cast_shadows>true</cast_shadows>
        <intensity>1.0</intensity>
      </light>
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://gold_base/meshes/model.dae</uri>
          </mesh>
        </geometry>
        <material>
          <script>
            <uri>model://gold_base/materials/scripts/</uri>
            <uri>model://gold_base/materials/textures/</uri>
            <name>Gold/Material</name>
            <name>Gold/Metal</name>
  	  </script>
	</material>
        <surface/>
        <contact/>
        <collide_bitmask>0x01</collide_bitmask>
      </collision>
    </link>
  </model>
  <static>true</static>
</sdf>
